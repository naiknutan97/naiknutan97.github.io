# Google OAuth 2.0 credentials for Drive photo access
# 1. Go to https://console.cloud.google.com/ -> APIs & Services -> Credentials
# 2. Create an OAuth 2.0 Client ID (Desktop application type)
# 3. Add http://localhost:3456 and http://localhost:3457 to "Authorized redirect URIs"
# 4. Copy the Client ID and Client Secret here:

GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
